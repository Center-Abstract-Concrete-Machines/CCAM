---
interface Props {
    collection: string;
    entryId: string;
    error: unknown;
}

const { collection, entryId, error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : String(error);
---

<div class="my-6 border border-dashed border-red-700/40 bg-red-100/60 px-4 py-3 text-sm text-red-900">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em]">Content render error</p>
    <p class="mt-2 font-semibold">{collection}/{entryId}</p>
    <p class="mt-2">
        Astro could not render this content entry. Check the MDX body for invalid markup or
        a component call with missing props.
    </p>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap break-words font-mono text-xs leading-5">{errorMessage}</pre>
</div>