---
const { gallery } = Astro.props;

import { Picture } from 'astro:assets';
import { getOptimizedImagesForGallery } from '@utils/galleryHelpers';

const optimizedImages = await getOptimizedImagesForGallery(gallery);

let galleryWidth;
if (optimizedImages.length <= 2) {
    galleryWidth = 'double';
} else if (optimizedImages.length === 3) {
    galleryWidth = 'triple';
} else {
    galleryWidth = 'quad';
}

// Function to get CSS transform based on EXIF orientation
function getOrientationTransform(orientation) {
    switch (orientation) {
        case 2: return 'scaleX(-1)'; // flip horizontal
        case 3: return 'rotate(180deg)'; // rotate 180°
        case 4: return 'scaleY(-1)'; // flip vertical  
        case 5: return 'rotate(-90deg) scaleX(-1)'; // rotate 90° CCW + flip horizontal
        case 6: return 'rotate(90deg)'; // rotate 90° CW
        case 7: return 'rotate(90deg) scaleX(-1)'; // rotate 90° CW + flip horizontal
        case 8: return 'rotate(-90deg)'; // rotate 90° CCW
        default: return 'none'; // orientation 1 or unknown
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    </head>
    <body>
        <div id="lightgallery" class=`card-grid ${galleryWidth} pb-4`>
            {
                gallery &&
                    optimizedImages.map((obj) => (
                        <a
                            href={obj.optimized.src}
                            target="_blank"
                            data-sub-html=".caption"
                        >
                            <Picture
                                src={obj.optimized.src}
                                alt=""
                                width={obj.optimized.attributes.width}
                                height={obj.optimized.attributes.height}
                                widths={[400, 600, 1200, 1600]}
                                sizes="(min-width: 640px) 25vw, 100vw"
                                class="aspect-square object-cover object-center"
                                style={`transform: ${getOrientationTransform(obj.orientation || 1)};`}
                            />
                            <div class="caption">
                                {obj.caption && (
                                    <p class="text-sm font-mono whitespace-nowrap overflow-hidden text-ellipsis">
                                        {obj.caption}
                                    </p>
                                )}
                                {obj.credit && (
                                    <p class="opacity-50 text-xs font-mono whitespace-nowrap overflow-hidden text-ellipsis">
                                        Photo: {obj.credit}
                                    </p>
                                )}
                            </div>
                        </a>
                    ))
            }
        </div>
        
        <script>
            import lightGallery from 'lightgallery';
            import 'lightgallery/css/lightgallery.css';
            
            document.addEventListener('astro:page-load', () => {
                const el = document.getElementById('lightgallery');
                if (el) {
                    lightGallery(el, {
                        plugins: [],
                        speed: 200,
                    });
                }
            });
        </script>
    </body>
</html>
