---
import Stripe from 'stripe';

interface Props {
    stripeProductId: string;
    endDate?: Date | 'ongoing';
}

const { stripeProductId, endDate } = Astro.props;

const isClosed = endDate && endDate !== 'ongoing' && new Date() > endDate;

const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY);

let product: Stripe.Product | null = null;
let price: Stripe.Price | null = null;

try {
    product = await stripe.products.retrieve(stripeProductId, {
        expand: ['default_price'],
    });
    price = product.default_price as Stripe.Price;
} catch {
    // Product not found — render nothing
}

if (!product?.active || !price) return;

function parseInventoryCount(value: string | undefined) {
    if (!value) return null;
    const parsed = Number.parseInt(value, 10);
    return Number.isNaN(parsed) || parsed < 0 ? null : parsed;
}

const inventoryCount = parseInventoryCount(product.metadata.inventory_count);
const isFree = !price.unit_amount || price.unit_amount === 0;
const isFullyBooked = typeof inventoryCount === 'number' && inventoryCount <= 0;

const formatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: (price.currency ?? 'usd').toUpperCase(),
});
const priceDisplay = isFree
    ? 'Free'
    : formatter.format((price.unit_amount ?? 0) / 100);
const priceId = price.id;
---

<div class="my-8 border border-dashed border-borderColor/30 p-6 space-y-4">
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="space-y-1">
            <p
                class="font-mono text-xs uppercase tracking-wider text-textColor/50"
            >
                Registration
            </p>
            <p class="font-sans text-2xl">{priceDisplay}</p>
            {
                typeof inventoryCount === 'number' && !isClosed && (
                    <p class="font-mono text-xs text-textColor/50">
                        {isFullyBooked
                            ? 'Fully booked'
                            : `${inventoryCount} spot${inventoryCount === 1 ? '' : 's'} remaining`}
                    </p>
                )
            }
        </div>

        {
            isClosed ? (
                <button class="button opacity-50 cursor-not-allowed" disabled>
                    Registration Closed
                </button>
            ) : isFullyBooked ? (
                <button class="button opacity-50 cursor-not-allowed" disabled>
                    Fully Booked
                </button>
            ) : (
                <form
                    data-price-id={priceId}
                    data-is-free={String(isFree)}
                    class="reg-form"
                >
                    <button type="submit" class="button reg-btn">
                        {isFree
                            ? 'Register — Free'
                            : `Register — ${priceDisplay}`}
                    </button>
                    <p class="reg-error text-Orange text-xs font-mono mt-2 hidden" />
                </form>
            )
        }
    </div>
</div>

<script>
    document.querySelectorAll<HTMLFormElement>('.reg-form').forEach((form) => {
        const btn = form.querySelector<HTMLButtonElement>('.reg-btn');
        const errorEl = form.querySelector<HTMLParagraphElement>('.reg-error');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!btn) return;

            btn.disabled = true;
            btn.textContent = 'Redirecting…';
            if (errorEl) errorEl.classList.add('hidden');

            const priceId = form.dataset.priceId;

            try {
                const res = await fetch(
                    '/api/store/create-registration-session',
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ priceId, quantity: 1 }),
                    }
                );

                const data = await res.json();
                if (!res.ok)
                    throw new Error(data.error ?? 'Registration failed');
                window.location.assign(data.url);
            } catch (err) {
                if (errorEl) {
                    errorEl.textContent =
                        err instanceof Error
                            ? err.message
                            : 'Registration failed';
                    errorEl.classList.remove('hidden');
                }
                if (btn) {
                    btn.disabled = false;
                    btn.textContent =
                        form.dataset.isFree === 'true'
                            ? 'Register — Free'
                            : 'Register';
                }
            }
        });
    });
</script>
