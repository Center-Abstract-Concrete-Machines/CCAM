---
import Base from '@layouts/Base.astro';
import HorizontalSpacer from '@components/HorizontalSpacer.astro';
import TagsList from '@components/TagsList.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProgramCard from '@components/Programs/ProgramCard.astro';
import PeopleDisplay from '@components/PeopleDisplay.astro';
import ResourcesDisplay from '@components/Resources/ResourcesDisplay.astro';
import { getOptimizedImagesForGallery } from '@utils/galleryHelpers';

const { title, subtitle, image, tags, projectId, people } =
    Astro.props.frontmatter;

const associatedPrograms = await getCollection('programs', ({ data }) => {
    return data.tags.includes(projectId) || data.assProjectId === projectId;
});

const orderedPrograms = [...associatedPrograms].sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const programsWithGallery = orderedPrograms.filter(
    (program) => program.data.gallery
);
const programsWithoutGallery = orderedPrograms.filter(
    (program) => !program.data.gallery
);

const programsWithGalleryPreview = await Promise.all(
    programsWithGallery.map(async (program) => ({
        program,
        previewImages: (
            await getOptimizedImagesForGallery(program.data.gallery)
        ).slice(0, 6),
    }))
);

const associatedResources = await getCollection('resources', ({ data }) => {
    return data.tags.includes(projectId) || data.assProjectId === projectId;
});
---

<Base title={title}>
    <div class="p-4">
        <div class="mx-auto max-w-2xl">
            <h1
                class="text-4xl uppercase font-semibold leading-tight tracking-tight text-center py-24 break-words"
            >
                {title}
                {
                    subtitle && (
                        <span>
                            : <br />
                            {subtitle}
                        </span>
                    )
                }
            </h1>
        </div>
        <HorizontalSpacer />
        <div class="mx-auto py-4 max-w-2xl">
            <div>
                <Picture
                    src={image.url}
                    alt={image.alt}
                    class="mx-auto"
                    widths={[400, 600, 1200, 1600]}
                    width="1600"
                />
            </div>
        </div>

        <div
            class="prose dark:prose-invert prose-headings:font-semibold mx-auto my-4 mb-12"
        >
            <slot />
            <TagsList tags={tags} class="my-12 mb-16" />
        </div>

        {
            programsWithGalleryPreview.length > 0 && (
                <>
                    <HorizontalSpacer class="my-4" />
                    <h2 class="text-2xl sm:text-3xl font-semibold text-center my-12">
                        Events
                    </h2>
                    <HorizontalSpacer class="my-4" />
                    <div class="grid gap-8">
                        {programsWithGalleryPreview.map(
                            ({ program, previewImages }) => (
                                <>
                                    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] items-start p-4">
                                        <ProgramCard
                                            headingSize="text-xl"
                                            slug={program.id}
                                            frontmatter={program.data}
                                        />
                                        <div>
                                            <a
                                                href={`/programs/${program.id}-gallery`}
                                                class="no-underline block"
                                            >
                                                <div class="grid grid-cols-3 gap-2">
                                                    {previewImages.map(
                                                        ({ optimized }) => (
                                                            <Picture
                                                                src={
                                                                    optimized.src
                                                                }
                                                                alt=""
                                                                width={
                                                                    optimized
                                                                        .attributes
                                                                        .width
                                                                }
                                                                height={
                                                                    optimized
                                                                        .attributes
                                                                        .height
                                                                }
                                                                widths={[
                                                                    400, 600,
                                                                    1200, 1600,
                                                                ]}
                                                                sizes="(min-width: 1024px) 12vw, 30vw"
                                                                class="aspect-[4/3] object-cover object-center opacity-60"
                                                            />
                                                        )
                                                    )}
                                                </div>
                                            </a>
                                            <a
                                                href={`/programs/${program.id}-gallery`}
                                                class="mx-auto text-textColor w-fit font-mono no-underline border border-dashed border-borderColor/50 px-4 py-2 hover:bg-backgroundHover/5 disabled:text-gray-400 disabled:border-borderColor/10 break-words block my-4"
                                            >
                                                View gallery
                                            </a>
                                        </div>
                                    </div>
                                    <HorizontalSpacer class="my-4" />
                                </>
                            )
                        )}
                    </div>
                </>
            )
        }
        {
            programsWithoutGallery.length > 0 && (
                <>
                    <HorizontalSpacer class="my-4" />

                    <div class="grid gap-8">
                        {programsWithoutGallery.map((program) => (
                            <>
                                <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] items-start p-4">
                                    <ProgramCard
                                        headingSize="text-xl"
                                        slug={program.id}
                                        frontmatter={program.data}
                                    />
                                    <div class="hidden lg:flex h-full min-h-24 items-center justify-center border border-dashed border-borderColor/20 font-mono text-xs opacity-60"></div>
                                </div>
                                <HorizontalSpacer class="my-4" />
                            </>
                        ))}
                    </div>
                </>
            )
        }

        {people && <PeopleDisplay people={people} />}

        {
            associatedResources.length > 0 && (
                <div>
                    <HorizontalSpacer class="my-4" />
                    <h2 class="text-2xl sm:text-3xl font-semibold text-center my-12">
                        Resources
                    </h2>
                    <HorizontalSpacer class="my-4" />
                    <ResourcesDisplay tag={projectId} />
                </div>
            )
        }
    </div>
</Base>
