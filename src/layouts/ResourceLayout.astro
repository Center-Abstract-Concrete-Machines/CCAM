---
import HorizontalSpacer from '@components/HorizontalSpacer.astro';
import ResourceType from '@components/ResourceType.astro';
import TagsList from '@components/TagsList.astro';
import Base from '@layouts/Base.astro';
import { Image, Picture } from 'astro:assets';
import GalleryPreview from '@components/GalleryPreview.astro';

const { title, author, type, year, image, tags, url, gallery } = Astro.props.frontmatter;
const { slug } = Astro.props;
---

<Base title={title}>
    <div class="p-4">
        <div class="mx-auto max-w-2xl">
            {
                image && (
                    <>
                        <div class="mb-4 mx-auto w-fit">
                            <Picture
                                src={image.url}
                                alt={image.alt}
                                widths={[400, 600, 1200, 1600]}
                                class="max-w-full"
                            />
                        </div>
                        <HorizontalSpacer />
                    </>
                )
            }
            <div>
                <h1
                    class="text-2xl md:text-3xl font-semibold text-balance break-words"
                >
                    {title}
                </h1>
                <div
                    class="flex flex-wrap justify-start items-center gap-2 pt-2 font-mono text-xs"
                >
                    <ResourceType type={type} />
                    {
                        author && year && (
                            <div>
                                {author}
                                <span class="opacity-30">|</span>
                                {year}
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
        <div
            class="prose dark:prose-invert prose-headings:font-semibold mx-auto max-w-2xl py-4"
        >
            <slot />
            <TagsList tags={tags} class="my-12" />
        </div>
        {
            gallery && (
                <>
                    <HorizontalSpacer class="my-4" />
                    <h2 class="text-2xl sm:text-3xl font-semibold text-center my-12">
                        Gallery
                    </h2>
                    <HorizontalSpacer class="my-4" />
                    <div id="gallery-target" class="mb-12">
                        <GalleryPreview
                            gallery={gallery}
                            galleryPagePath={`/resources/${slug}-gallery#gallery-target`}
                        />
                    </div>
                    <iframe hidden name=htmz onload="setTimeout(()=>{document.querySelector(contentWindow.location.hash||null)?.replaceWith(...contentDocument.body.childNodes);
                        const galleryLoadedEvent = new CustomEvent('gallery-loaded');
                        document.dispatchEvent(galleryLoadedEvent);})"></iframe>
                </>
            )
        }
    </div>
</Base>

<script>
    import lightGallery from 'lightgallery';
    import 'lightgallery/css/lightgallery.css';
    document.addEventListener('gallery-loaded', () => {
        const el = document.getElementById('lightgallery');
        if (!el) return;
        lightGallery(el, {
            licenseKey: '0000-0000-000-0000',
            speed: 200,
            download: false,
            hideControlOnEnd: true,
            loop: false,
            subHtmlSelectorRelative: true,
            mobileSettings: {
                controls: false,
                showCloseIcon: true,
            },
        });
    });
</script>
