---
import BioLayout from '../../layouts/BioLayout.astro';
import { getCollection, render } from 'astro:content';
import ContentRenderError from '@components/ContentRenderError.astro';

import { organizerList, boardOfDirectorsList, websiteList, collaboratorsList } from 'src/metadata';

export async function getStaticPaths() {
    const organizers = await getCollection(
        'people',
        (person) =>
            organizerList.includes(person.id) ||
            boardOfDirectorsList.includes(person.id) ||
            collaboratorsList.includes(person.id) ||
            websiteList.includes(person.id)
    );
    return organizers.map((organizer) => ({
        params: { slug: organizer.id },
        props: { organizer },
    }));
}

const { organizer } = Astro.props;
let renderResult: Awaited<ReturnType<typeof render>> | undefined;
let contentError: unknown;

try {
    renderResult = await render(organizer);
} catch (error) {
    contentError = error;

    if (!import.meta.env.DEV) {
        throw error;
    }
}

const Content = renderResult?.Content;
---

<BioLayout frontmatter={organizer.data} slug={organizer.id}>
    {
        Content ? (
            <Content />
        ) : (
            <ContentRenderError
                collection={organizer.collection}
                entryId={organizer.id}
                error={contentError}
            />
        )
    }
</BioLayout>
