---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';

import Base from '@layouts/Base.astro';
import ProgramCard from '@components/Programs/ProgramCard.astro';
import ResourceCard from '@components/ResourceCard.astro';
import GridSpacer from '@components/GridSpacer.astro';
import HorizontalSpacer from '@components/HorizontalSpacer.astro';
import Brackets from '@components/Brackets.astro';
import IndexGlitchTitle from '@components/IndexGlitchTitle.astro';
import {
    getAllGalleryImages,
    getRandomImage,
} from '@utils/randomGalleryImage.js';

import {
    filterDraftsAndPubDate,
    isEventUpcoming,
    sortAscByEndDate,
    sortDescByEndDate,
} from '@utils/programFilters';

const allPrograms = await getCollection('programs');
const allGalleryImages = await getAllGalleryImages({
    limit: 24,
    width: 960,
    quality: 60,
});
const initialRandomImage = getRandomImage(allGalleryImages);
const initialSecondaryImage =
    allGalleryImages.find((image) => image.src !== initialRandomImage?.src) ||
    initialRandomImage;
const fallbackSplashImage = allGalleryImages[0] ?? null;

// Get random resources for display
const allResources = await getCollection('resources');
function shuffleArray(array) {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
}
const randomResources = shuffleArray(allResources).slice(0, 5);

let featuredPrograms = allPrograms
    .filter(filterDraftsAndPubDate)
    .filter(({ data }) => isEventUpcoming(data))
    .filter(({ data }) => data.featured === true)
    .sort(sortAscByEndDate)
    .slice(0, 2);

// If there aren't two upcoming events, add the most recent events
if (featuredPrograms.length < 2) {
    const lastestTwoFeaturedPrograms = allPrograms
        .filter(filterDraftsAndPubDate)
        .filter(({ data }) => data.featured === true)
        .sort(sortDescByEndDate)
        .slice(0, 2);
    if (featuredPrograms.length === 1) {
        featuredPrograms.push(lastestTwoFeaturedPrograms[1]);
    } else if (featuredPrograms.length === 0) {
        featuredPrograms.push(...lastestTwoFeaturedPrograms);
    }
}
---

<Base>
    <!-- Splash -->
    <section class="px-4 pt-4">
        <div class="thirds-container grid gap-4 justify-items-center">
            <IndexGlitchTitle />
            <GridSpacer class="hidden sm:block" />
            <div class="w-full hidden sm:block">
                <div
                    id="dynamic-image-container"
                    class="max-w-full mx-auto aspect-square overflow-hidden"
                >
                    <a
                        id="dynamic-image-link"
                        href={initialRandomImage?.link || '#'}
                        class="block w-full h-full"
                        title={initialRandomImage?.link
                            ? `View ${initialRandomImage.type}: ${initialRandomImage.title}`
                            : initialRandomImage?.alt || 'Gallery image'}
                        style={initialRandomImage?.link
                            ? 'cursor: pointer'
                            : 'cursor: default'}
                    >
                        <img
                            id="dynamic-image"
                            src={initialRandomImage?.src ||
                                fallbackSplashImage?.src ||
                                ''}
                            alt={initialRandomImage?.alt ||
                                fallbackSplashImage?.alt ||
                                'Splash image'}
                            class="w-full h-full object-cover"
                        />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Overview -->

    <section class="px-4 pt-4">
        <HorizontalSpacer class="pb-4" />
        <div class="grid thirds-container gap-4">
            <Brackets>
                <p class="max-w-[60%] mx-auto text-lg sm:text-xl text-balance">
                    Center for Concrete and Abstract Machines is an artist-run
                    project at the nexus of art, technology, and philosophy.
                </p>
            </Brackets>
            <GridSpacer />
            <div
                class="flex gap-4 justify-stretch align-stretch flex-col pt-4 sm:pt-0 min-h-[195px]"
            >
                <a href="/programs/" class="flex grow">
                    <div
                        class="font-mono border border-dashed border-borderColor/30 hover:bg-backgroundHover/5 grow grid place-items-center"
                    >
                        Program Calendar
                    </div></a
                >
                <a href="/projects/" class="flex grow">
                    <div
                        class="font-mono border border-dashed border-borderColor/30 hover:bg-backgroundHover/5 grow grid place-items-center"
                    >
                        Research Projects
                    </div></a
                >
                <a href="/about/" class="flex grow">
                    <div
                        class="font-mono border border-dashed border-borderColor/30 hover:bg-backgroundHover/5 grow grid place-items-center"
                    >
                        About Us
                    </div></a
                >
            </div>
        </div>
    </section>

    <!-- Programs -->
    <section class="pt-4">
        <HorizontalSpacer class="mx-4" />
        <div class="header flex justify-between items-center px-4 pt-4">
            <h2 class="text-3xl font-medium">Upcoming + Recent Programs</h2>
            <a href="/programs/">
                <div class="button font-mono">View All</div>
            </a>
        </div>
        <div class="card-grid double p-4">
            {
                featuredPrograms.map((program) => (
                    <div>
                        <ProgramCard
                            slug={program.id}
                            frontmatter={program.data}
                        />
                    </div>
                ))
            }
        </div>
    </section>

    <!-- About -->
    <section class="px-4">
        <HorizontalSpacer class="mb-4" />
        <div class="grid place-items-center mx-4">
            <div class="grid grid-cols-1 lg:grid-cols-2 lg:w-10/12 py-20 gap-8">
                <div
                    class="flex flex-col justify-between items-start order-2 lg:order-1"
                >
                    <p class="text-xl">
                        Nomadically based in Chicago, CCAM is an artist-run
                        platform at the nexus of art, technology, and
                        contemporary thought. CCAM’s primary goal is building an
                        accessible community for the development and sharing of
                        abstract ideas and forms of technical know-how,
                        know-when, and know-why historically siloed in academia.
                    </p>
                    <a href="/about/"
                        ><div class="button font-mono mt-8">Learn More</div></a
                    >
                </div>
                <div
                    class="mx-auto order-1 lg:order-2 self-center justify-self-center"
                >
                    <div
                        id="secondary-image-container"
                        class="aspect-video overflow-hidden"
                    >
                        <a
                            id="secondary-image-link"
                            href={initialSecondaryImage?.link || '#'}
                            class="block w-full h-full"
                            title={initialSecondaryImage?.link
                                ? `View ${initialSecondaryImage.type}: ${initialSecondaryImage.title}`
                                : initialSecondaryImage?.alt || 'Gallery image'}
                        >
                            <img
                                id="secondary-image"
                                src={initialSecondaryImage?.src ||
                                    fallbackSplashImage?.src ||
                                    ''}
                                alt={initialSecondaryImage?.alt ||
                                    fallbackSplashImage?.alt ||
                                    'Splash image'}
                                class="w-full h-full object-cover object-bottom"
                            />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Resources -->
    <section class="px-4">
        <HorizontalSpacer class="pb-4" />
        <div class="header flex justify-between items-center">
            <h2 class="text-3xl font-medium">Resources</h2>
            <a href="/resources/">
                <div class="button font-mono">View All</div>
            </a>
        </div>
        <div class="pt-4">
            {
                randomResources.map((resource) => (
                    <ResourceCard
                        metadata={resource.data}
                        slug={resource.id}
                        metaSlug="resources"
                    />
                ))
            }
        </div>
    </section>
</Base>

<script define:vars={{ allGalleryImages, initialRandomImage, initialSecondaryImage }}>
    function getRandomImage(images) {
        if (!images || images.length === 0) return null;
        return images[Math.floor(Math.random() * images.length)];
    }

    function getRandomImageDifferentFrom(images, excludedSrc) {
        if (!images || images.length === 0) return null;

        if (!excludedSrc) return getRandomImage(images);

        const filteredImages = images.filter((image) => image.src !== excludedSrc);

        if (filteredImages.length === 0) {
            return getRandomImage(images);
        }

        return getRandomImage(filteredImages);
    }

    let currentDynamicImageSrc = initialRandomImage?.src || null;
    let currentSecondaryImageSrc = initialSecondaryImage?.src || null;

    function changeToRandomImage() {
        if (!allGalleryImages || allGalleryImages.length === 0) return;

        const randomImage = getRandomImageDifferentFrom(
            allGalleryImages,
            currentSecondaryImageSrc
        );
        const dynamicImage = document.getElementById('dynamic-image');
        const dynamicLink = document.getElementById('dynamic-image-link');

        if (randomImage && dynamicImage && dynamicLink) {
            dynamicImage.src = randomImage.src;
            dynamicImage.alt = randomImage.alt;

            // Update link - if no associated link, disable clicking
            if (randomImage.link) {
                dynamicLink.href = randomImage.link;
                dynamicLink.style.cursor = 'pointer';
                dynamicLink.title = `View ${randomImage.type}: ${randomImage.title}`;
                dynamicLink.onclick = null; // Remove any previous click handler
            } else {
                dynamicLink.href = '#';
                dynamicLink.style.cursor = 'default';
                dynamicLink.title = randomImage.alt;
                // Prevent navigation if no link
                dynamicLink.onclick = (e) => {
                    e.preventDefault();
                    return false;
                };
            }

            currentDynamicImageSrc = randomImage.src;
        }
    }

    function changeSecondaryImage() {
        if (!allGalleryImages || allGalleryImages.length === 0) return;

        const randomImage = getRandomImageDifferentFrom(
            allGalleryImages,
            currentDynamicImageSrc
        );
        const secondaryImage = document.getElementById('secondary-image');
        const secondaryLink = document.getElementById('secondary-image-link');

        if (randomImage && secondaryImage && secondaryLink) {
            secondaryImage.src = randomImage.src;
            secondaryImage.alt = randomImage.alt;

            // Update link
            if (randomImage.link) {
                secondaryLink.href = randomImage.link;
                secondaryLink.style.cursor = 'pointer';
                secondaryLink.title = `View ${randomImage.type}: ${randomImage.title}`;
                secondaryLink.onclick = null;
            } else {
                secondaryLink.href = '#';
                secondaryLink.style.cursor = 'default';
                secondaryLink.title = randomImage.alt;
                secondaryLink.onclick = (e) => {
                    e.preventDefault();
                    return false;
                };
            }

            currentSecondaryImageSrc = randomImage.src;
        }
    }

    const ROTATION_INTERVAL_MS = 5000;
    let dynamicImageTimer;
    let secondaryImageTimer;

    // Listen for morpher changes
    document.addEventListener('astro:page-load', () => {
        document.addEventListener('morpherChange', changeToRandomImage);

        // Set up initial click handler for the splash image
        const dynamicLink = document.getElementById('dynamic-image-link');
        if (dynamicLink) {
            if (initialRandomImage?.link) {
                dynamicLink.onclick = null;
            } else {
                dynamicLink.onclick = (e) => {
                    e.preventDefault();
                    return false;
                };
            }
        }

        // Set up initial click handler for the secondary image
        const secondaryLink = document.getElementById('secondary-image-link');
        if (secondaryLink) {
            if (initialSecondaryImage?.link) {
                secondaryLink.onclick = null;
            } else {
                secondaryLink.onclick = (e) => {
                    e.preventDefault();
                    return false;
                };
            }
        }

        dynamicImageTimer = setInterval(changeToRandomImage, ROTATION_INTERVAL_MS);
        secondaryImageTimer = setInterval(changeSecondaryImage, ROTATION_INTERVAL_MS);
    });

    // Clean up event listener and timer
    document.addEventListener('astro:before-preparation', () => {
        document.removeEventListener('morpherChange', changeToRandomImage);
        if (dynamicImageTimer) {
            clearInterval(dynamicImageTimer);
        }
        if (secondaryImageTimer) {
            clearInterval(secondaryImageTimer);
        }
    });
</script>
