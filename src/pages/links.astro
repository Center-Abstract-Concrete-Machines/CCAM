---
import Base from '@layouts/Base.astro';
import Picture from 'astro/components/Picture.astro';
import TitleCard from '@components/TitleCard.astro';

// Edit title and description here
const heading = {
    title: '🔗🔗🔗',
    description: null,
};

// Import Images before using them in links
// https://docs.astro.build/en/guides/images/#images-in-astro-files
import { getRandomPlaceholderImage } from '@utils/getRandomPlaceholderImage';
import LinkCard from '@components/LinkCard.astro';
import Estuary from 'src/content/programs/images/estuary-play.png';
import Microsound from 'src/content/programs/images/microsound.png';
import See from 'src/content/programs/images/how-to-see.png';
import WDKY from 'src/content/programs/images/wdkyIII.png';
import Processing from 'src/content/programs/images/processing.png';
import list from 'src/images/list.png';
import RG from 'src/content/programs/images/school-1.png';
import BADS from 'src/content/programs/images/bads-2026.jpg';
import maddie from 'src/content/programs/images/2026-07-02-maddie.jpg';
import codemoves from 'src/content/programs/images/codemoves.png';

import claire from 'src/content/programs/images/fleming-staples.png';

import zoe from 'src/content/programs/images/zoe-butler.jpg';

// Edit links here
const links = [
    {
        image: list,
        name: 'MAILING LIST SIGN UP',
        description: 'STAY IN THE MIX IN 2026',
        url: 'https://mailchi.mp/e2d83bb967aa/welcome-to-ccam-world',
    },
    {
        image: maddie,
        name: 'Maddie Brucker: Deconstructing the Image',
        description:
            'Creative Coding Workshop // 7.2.26 6-8pm @ Mouse Arts and Letters',
        url: '/programs/26-07-02-maddie-brucker-almanac/',
    },
    {
        image: claire,
        name: 'Claire Fleming: New Virtual Worlds',
        description: '3D Digital Spaces Workshop // 7.27.26 6-8pm @ MANA Contemporary in Pilsen',
        url: '/programs/26-07-27-claire-fleming-staples-almanac/',
    },
    {
        image: codemoves,
        name: 'Codemoves: Body - Time - Space',
        description: 'Movement and Code Workshop // 8.15.26 6-8pm @ ALMANAC',
        url: '/programs/26-08-15-codemoves-almanac/',
    },
    {
        image: zoe,
        name: 'Zoe Butler: Virtual Mas',
        description: 'Blender Workshop // 9.21.26 6-8pm @ ALMANAC',
        url: '/programs/26-09-21-zoe-butler-almanac/',
    },
    {
        image: BADS,
        name: 'BADS_LAB 2026 Concluding Event',
        description:
            'WORK SHOWING OPEN SESSION // 6.20.26 2-5pm @ THE LAND SCHOOL',
        url: '/programs/26-04-19-ccam-school-reading-group-2-1/',
    },
    {
        image: RG,
        name: 'Creativity + (In)Computability',
        description: 'Reading Group 2.1 // 4.19.26 2-4pm @ FLATLINE GALLERY',
        url: '/programs/26-04-19-ccam-school-reading-group-2-1/',
    },
    {
        image: WDKY,
        name: "We Don't Know Yet: What a Cinema Can Do |||",
        description:
            '04/10/26 // doors @ 7; show @ 8 // $35 / $40 door // A Night of Expanded Cinema in Collaboration with Onion City Film Festival',
        url: 'https://chicagofilmmakers.org/upcoming-screenings-and-events/we-dont-know-yet-what-a-cinema-can-do',
    },
    {
        image: Microsound,
        name: 'Intro to Microsound  YouTube Recordings',
        description:
            'CCAM x Experimental Sound Studio (ESS) // 4-Part Max/MSP Gen~ Course with Grace Grace Grace',
        url: 'https://www.youtube.com/playlist?list=PLBxbddARljQ_stWW515ak5JRRTZLoTny4',
    },
    {
        image: Processing,
        name: 'World Processing Community Day Info Signup',
        description:
            "Join us for Chicago' World Processing Community Day October 2026 in collaboration with Peripheral x Study! Sign up to stay in the loop.",
        url: '/programs/26-10-processing-day/',
    },
    // {
    //     image: getRandomPlaceholderImage(),
    //     name: 'Placeholder Link',
    //     description:
    //         "You can delete this object. If you don't have an image to use for a link, you can use the getRandomPlaceholderImage() function to bring in a rando",
    //     url: 'https://parkerdavis.dev',
    // },
];
---

<Base title="LINK IN BIO">
    <div class="p-4">
        <div class="mx-auto max-w-2xl">
            <TitleCard
                title={heading.title}
                description={heading.description}
            />
            <main class="my-4">
                <ul class="flex gap-4 flex-col">
                    {links.map((link) => <LinkCard link={link} />)}
                </ul>
            </main>
        </div>
    </div>
</Base>
