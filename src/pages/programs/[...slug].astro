---
import ProgramLayout from '../../layouts/ProgramLayout.astro';
import { getCollection, render } from 'astro:content';
import { YouTube } from 'astro-embed';
import ContentRenderError from '@components/ContentRenderError.astro';
import LinkButton from '@components/LinkButton.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
    const programs = await getCollection('programs');
    return programs.map((program) => ({
        params: { slug: program.id },
        props: { program },
    }));
}

const { program } = Astro.props;
let renderResult: Awaited<ReturnType<typeof render>> | undefined;
let contentError: unknown;

try {
    renderResult = await render(program);
} catch (error) {
    contentError = error;

    if (!import.meta.env.DEV) {
        throw error;
    }
}

const Content = renderResult?.Content;
---

<ProgramLayout frontmatter={program.data} slug={program.id}>
    {
        Content ? (
            <Content components={{ LinkButton, YouTube, Image }} />
        ) : (
            <ContentRenderError
                collection={program.collection}
                entryId={program.id}
                error={contentError}
            />
        )
    }
</ProgramLayout>
