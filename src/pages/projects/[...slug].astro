---
import { YouTube } from 'astro-embed';
import ContentRenderError from '@components/ContentRenderError.astro';
import LinkButton from '@components/LinkButton.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
let renderResult: Awaited<ReturnType<typeof render>> | undefined;
let contentError: unknown;

try {
    renderResult = await render(project);
} catch (error) {
    contentError = error;

    if (!import.meta.env.DEV) {
        throw error;
    }
}

const Content = renderResult?.Content;
---

<ProjectLayout frontmatter={project.data}>
    {
        Content ? (
            <Content components={{ LinkButton, YouTube, Image }} />
        ) : (
            <ContentRenderError
                collection={project.collection}
                entryId={project.id}
                error={contentError}
            />
        )
    }
</ProjectLayout>
