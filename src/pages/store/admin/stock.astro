---
export const prerender = false;

import Base from 'src/layouts/Base.astro';
import VariantStockAdmin from '@components/Store/VariantStockAdmin.svelte';
import { getCollection } from 'astro:content';

const entries = await getCollection('storeProducts');

const products = entries
    .map((entry) => ({
        id: entry.id,
        title: entry.data.title ?? entry.id,
        stripeProductId: entry.data.stripeProductId,
    }))
    .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Store Stock Admin">
    <VariantStockAdmin client:load {products} />
</Base>
