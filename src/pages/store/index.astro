---
export const prerender = false;

import Base from 'src/layouts/Base.astro';
import StoreGrid from '@components/Store/StoreGrid.svelte';
import Stripe from 'stripe';
import { getCollection } from 'astro:content';
import { getStripeServerClient } from '@utils/stripeServer';

const stripe = getStripeServerClient();

function parseInventoryCount(value: string | undefined) {
    if (!value) return null;
    const parsed = Number.parseInt(value, 10);
    return Number.isNaN(parsed) || parsed < 0 ? null : parsed;
}

async function buildSizeOptions(
    variants:
        | Array<{
              size: string;
              label?: string;
              stripePriceId: string;
          }>
        | undefined,
    fallbackCurrency: string
) {
    if (!variants || variants.length === 0) {
        return [];
    }

    const prices = await Promise.all(
        variants.map(async (variant) => {
            try {
                const variantPrice = await stripe.prices.retrieve(
                    variant.stripePriceId,
                    { expand: ['product'] }
                );
                if (
                    !variantPrice.active ||
                    !variantPrice.unit_amount ||
                    variantPrice.type !== 'one_time'
                ) {
                    return null;
                }

                const variantProduct = variantPrice.product as Stripe.Product;
                if (!variantProduct.active) {
                    return null;
                }

                const inventoryCount = parseInventoryCount(
                    variantPrice.metadata.inventory_count ??
                        variantProduct.metadata.inventory_count
                );

                return {
                    size: variant.size,
                    label: variant.label ?? variant.size,
                    priceId: variantPrice.id,
                    unitAmount: variantPrice.unit_amount,
                    currency: variantPrice.currency ?? fallbackCurrency,
                    inventoryCount,
                };
            } catch {
                return null;
            }
        })
    );

    return prices.filter(Boolean) as Array<{
        size: string;
        label: string;
        priceId: string;
        unitAmount: number;
        currency: string;
        inventoryCount: number | null;
    }>;
}

// Fetch all active products with their prices from Stripe
const productsResponse = await stripe.products.list({
    active: true,
    expand: ['data.default_price'],
});

const storeContentEntries = await getCollection('storeProducts');
const storeContentByStripeProductId = new Map(
    storeContentEntries.map((entry) => [entry.data.stripeProductId, entry])
);

const filteredProducts = productsResponse.data
    .filter((p) => {
        const price = p.default_price as Stripe.Price | null;
        return price && price.unit_amount !== null && price.type === 'one_time';
    })
    .filter((p) => {
        // Exclude Stripe products flagged as registrations via metadata
        if (p.metadata.registration === 'true') return false;
        // Exclude products that have a content entry marked as workshopRegistration
        const contentEntry = storeContentByStripeProductId.get(p.id);
        return !contentEntry?.data.workshopRegistration;
    });

const products = await Promise.all(
    filteredProducts.map(async (p) => {
        const price = p.default_price as Stripe.Price;
        const inventoryCount = parseInventoryCount(p.metadata.inventory_count);
        const contentEntry = storeContentByStripeProductId.get(p.id);
        const cardImage =
            contentEntry?.data.heroImage?.src ?? p.images[0] ?? '';
        const cardDescription =
            contentEntry?.data.excerpt ?? p.description ?? '';
        const detailHref = contentEntry
            ? `/store/${contentEntry.id}`
            : `/store/${p.id}`;
        const sizeOptions = await buildSizeOptions(
            contentEntry?.data.sizeVariants,
            price.currency
        );

        return {
            id: p.id,
            name: contentEntry?.data.title ?? p.name,
            description: cardDescription,
            images: p.images,
            cardImage,
            detailHref,
            priceId: price.id,
            unitAmount: price.unit_amount!,
            currency: price.currency,
            inventoryCount,
            category: contentEntry?.data.category,
            tags: contentEntry?.data.tags ?? [],
            sizeOptions,
        };
    })
);

const publishableKey = import.meta.env.STRIPE_PUBLISHABLE_KEY;
const returnUrl = `${Astro.url.origin}/store/success`;
---

<Base title="Store">
    <section
        class="px-4 pt-12 pb-8 border-b border-dashed border-borderColor/30"
    >
        <h1 class="font-sans text-6xl sm:text-8xl mb-4">Store</h1>
        <a href="/store/cart" class="button">View Cart</a>
    </section>

    {
        products.length === 0 ? (
            <section class="px-4 py-16 flex items-center justify-center min-h-64">
                <p class="font-mono text-lg text-textColor/50">
                    No products available yet.
                </p>
            </section>
        ) : (
            <StoreGrid client:load {products} {publishableKey} {returnUrl} />
        )
    }
</Base>
