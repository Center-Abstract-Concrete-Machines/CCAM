---
export const prerender = false;

import Base from 'src/layouts/Base.astro';
import Stripe from 'stripe';
import { getStripeServerClient } from '@utils/stripeServer';

const stripe = getStripeServerClient();

const paymentIntentId = Astro.url.searchParams.get('payment_intent');
const redirectStatus = Astro.url.searchParams.get('redirect_status');
const sessionId = Astro.url.searchParams.get('session_id');

let orderDetails: {
    productName: string;
    variantLabel: string | null;
    quantity: string;
    amount: number;
    currency: string;
} | null = null;
let cartOrderDetails: {
    total: number;
    currency: string;
    customerEmail: string | null;
    lineItems: Array<{ name: string; quantity: number }>;
} | null = null;

if (paymentIntentId && redirectStatus === 'succeeded') {
    try {
        const pi = await stripe.paymentIntents.retrieve(paymentIntentId);
        orderDetails = {
            productName: pi.metadata.productName ?? 'Order',
            variantLabel:
                pi.metadata.variantLabel || pi.metadata.variantSize || null,
            quantity: pi.metadata.quantity ?? '1',
            amount: pi.amount,
            currency: pi.currency,
        };
    } catch {
        // Failed to retrieve — show generic success
    }
}

if (sessionId) {
    try {
        const session = await stripe.checkout.sessions.retrieve(sessionId, {
            expand: ['line_items.data.price.product'],
        });

        if (session.payment_status === 'paid') {
            const lineItems =
                session.line_items?.data.map((lineItem) => ({
                    name:
                        (lineItem.price?.product as Stripe.Product | null)
                            ?.name ?? 'Item',
                    quantity: lineItem.quantity ?? 1,
                })) ?? [];

            cartOrderDetails = {
                total: session.amount_total ?? 0,
                currency: session.currency ?? 'usd',
                customerEmail: session.customer_details?.email ?? null,
                lineItems,
            };
        }
    } catch {
        // Failed to retrieve session — show generic success
    }
}

const failed = redirectStatus && redirectStatus !== 'succeeded';
---

<Base title="Order Confirmation">
    <section
        class="px-4 pt-12 pb-8 border-b border-dashed border-borderColor/30"
    >
        <h1 class="font-sans text-6xl sm:text-8xl mb-4">
            {failed ? 'Payment Failed' : 'Thank You'}
        </h1>
    </section>

    <section
        class="px-4 py-16 flex flex-col items-center justify-center min-h-64 gap-6"
    >
        {
            failed ? (
                <>
                    <p class="font-mono text-lg text-Orange">
                        Your payment was not completed.
                    </p>
                    <a href="/store" class="button">
                        Return to Store
                    </a>
                </>
            ) : (
                <>
                    <p class="font-mono text-lg text-textColor/80 text-balance text-center">
                        Your order has been received. You'll get a confirmation
                        email shortly.
                    </p>
                    {orderDetails && (
                        <div class="border border-dashed border-borderColor/30 p-6 font-mono text-sm max-w-sm w-full">
                            <div class="flex justify-between mb-2">
                                <span class="text-textColor/50">Product</span>
                                <span>{orderDetails.productName}</span>
                            </div>
                            {orderDetails.variantLabel && (
                                <div class="flex justify-between mb-2">
                                    <span class="text-textColor/50">Size</span>
                                    <span>{orderDetails.variantLabel}</span>
                                </div>
                            )}
                            <div class="flex justify-between mb-2">
                                <span class="text-textColor/50">Quantity</span>
                                <span>{orderDetails.quantity}</span>
                            </div>
                            <div class="flex justify-between border-t border-dashed border-borderColor/30 pt-2 mt-2">
                                <span class="text-textColor/50">Total</span>
                                <span>
                                    {new Intl.NumberFormat('en-US', {
                                        style: 'currency',
                                        currency:
                                            orderDetails.currency.toUpperCase(),
                                    }).format(orderDetails.amount / 100)}
                                </span>
                            </div>
                        </div>
                    )}

                    {cartOrderDetails && (
                        <div class="border border-dashed border-borderColor/30 p-6 font-mono text-sm max-w-md w-full">
                            <div class="mb-3">
                                <span class="text-textColor/50">Items</span>
                            </div>
                            <ul class="space-y-1 mb-3">
                                {cartOrderDetails.lineItems.map((item) => (
                                    <li class="flex justify-between">
                                        <span>{item.name}</span>
                                        <span>x{item.quantity}</span>
                                    </li>
                                ))}
                            </ul>
                            <div class="flex justify-between border-t border-dashed border-borderColor/30 pt-2 mt-2">
                                <span class="text-textColor/50">Total</span>
                                <span>
                                    {new Intl.NumberFormat('en-US', {
                                        style: 'currency',
                                        currency:
                                            cartOrderDetails.currency.toUpperCase(),
                                    }).format(cartOrderDetails.total / 100)}
                                </span>
                            </div>
                        </div>
                    )}
                    <a href="/store" class="button">
                        Back to Store
                    </a>
                </>
            )
        }
    </section>

    {
        sessionId && (
            <script>
                localStorage.removeItem('ccam_store_cart_v1');
                window.dispatchEvent(new CustomEvent('ccam-cart-updated'));
            </script>
        )
    }
</Base>
